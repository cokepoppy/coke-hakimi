# V3-only serial audio proof. The board was identified as ESP32-P4 revision
# v3.2; the post-build script enforces the v3.01-v3.99 bounds in the image.
CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
# The complete CJK font plus embedded pet frames make the application larger
# than the default 1 MB factory partition. Use the checked-in 4 MB layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The complete Hakimi GB2312 font is compiled from main/hakimi_font_cjk_14.c;
# high-priority labels use LVGL transform scaling to avoid duplicating it.
# Keep LVGL's smaller curated Source Han subset disabled to avoid duplicating
# about 1 MB of glyph data in the firmware image.
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_14_CJK is not set
# The 18 px full CJK font exceeds LVGL's compact 20-bit bitmap index.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
