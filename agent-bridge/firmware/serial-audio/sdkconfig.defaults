# V3-only serial audio proof. The board was identified as ESP32-P4 revision
# v3.2; the post-build script enforces the v3.01-v3.99 bounds in the image.
CONFIG_IDF_TARGET_ESP32P4=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
# The complete CJK font plus embedded pet frames make the application larger
# than the default 1 MB factory partition. Use the checked-in 4 MB layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Compact labels use main/hakimi_font_cjk_14.c and Agent output uses the native
# main/hakimi_font_cjk_20.c font. The larger text deliberately avoids LVGL
# transform scaling because transformed wrapped CJK text can disappear on the
# physical MIPI panel.
# Keep LVGL's smaller curated Source Han subset disabled to avoid duplicating
# about 1 MB of glyph data in the firmware image.
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_14_CJK is not set
# The full 20 px CJK font requires LVGL's large bitmap index.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
